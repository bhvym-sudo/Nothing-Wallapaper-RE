<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/start_btn_container" android:background="@drawable/dialog_btn_background_vertical_top" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/layout_padding_4xs">
        <TextView android:id="@id/start_btn" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Button" style="@style/NtDialogButtonText" />
    </FrameLayout>
    <FrameLayout android:id="@id/middle_btn_container" android:background="@drawable/dialog_btn_background_middle" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/layout_padding_4xs">
        <TextView android:id="@id/middle_btn" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Button" style="@style/NtDialogButtonText" />
    </FrameLayout>
    <FrameLayout android:id="@id/end_btn_container" android:background="@drawable/dialog_btn_background_vertical_bottom" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <TextView android:id="@id/end_btn" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="Button" style="@style/NtDialogButtonText" />
    </FrameLayout>
</LinearLayout>
